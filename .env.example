# =============================================================================
# YouFlix environment configuration
# =============================================================================
# EVERY value below is OPTIONAL.
# The application runs with ZERO keys configured, in read-only static mode.
# Copy this file to .env.local and fill in only what you need.
# =============================================================================

# --- Database / Auth (Supabase) ---------------------------------------------
# When BOTH are set, the app uses the Supabase data adapter and enables the
# admin dashboard + authentication. When unset, the app runs in read-only
# static mode using data/catalogue.json and the admin UI is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Required for admin mutations.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI categorization ------------------------------------------------------
# Optional. When unset, AI classification is DISABLED and manual
# categorization remains fully functional. Provider-independent.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Latest Movies feed (date-weighted randomization) -----------------------
# All optional. Unset values use the documented defaults below.
# Age-group weights must sum to 100; an invalid set falls back to 60/25/15.
FEED_WEIGHT_RECENT=60
FEED_WEIGHT_PREVIOUS=25
FEED_WEIGHT_OLDER=15
# Number of movies shown in the Latest Movies row.
FEED_SIZE=20
# How many recently shown movie ids to remember per visitor to reduce repeats.
# Set to 0 to disable repetition suppression.
FEED_RECENT_DISPLAY_WINDOW=40

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
